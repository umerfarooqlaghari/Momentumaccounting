# ─── Momentum Accounting backend ───────────────────────────────
# MongoDB Atlas (keep the cluster in a UK/EU region — prospectus §9)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/momentum_accounting

# Public URLs of each app (change for production)
PUBLIC_API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
SUPERADMIN_URL=http://localhost:3001
# Origins allowed to call this API from the browser (public website)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Secrets (generated — keep private, rotate if leaked)
JWT_SECRET=<openssl rand -base64 48>
REVALIDATE_SECRET=<openssl rand -hex 24>
CRON_SECRET=<openssl rand -hex 24>

# First superadmin owner account (used once by: npm run seed)
ADMIN_EMAIL=ben@momentumaccounting.uk
ADMIN_NAME=Ben Keville
ADMIN_PASSWORD=

# Email (SMTP) — any UK/EU provider in Momentum's name, e.g. Microsoft 365, Postmark, Brevo
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Momentum Accounting <enquiries@momentumaccounting.uk>"

# Momentum HQ lead sync (shared under NDA — leave blank until available)
MOMENTUM_HQ_API_URL=
MOMENTUM_HQ_API_KEY=

# Booking tool (Cal.com) webhook signing secret
BOOKING_WEBHOOK_SECRET=

# Google Places API (live Google reviews) — key + place ID from Momentum's Google account
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
